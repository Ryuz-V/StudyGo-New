<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBulanKiri"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/triangle_arrow"
            android:rotation="90"
            app:tint="#888888"
            android:padding="4dp"/> <TextView
        android:id="@+id/tvBulanTahun"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MEI  2026"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginStart="12dp"/>

        <ImageView
            android:id="@+id/btnBulanKanan"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/triangle_arrow"
            android:layout_marginStart="12dp"
            android:rotation="-90"
            app:tint="#888888"
            android:padding="4dp"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btnToggleCalendar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_up"
            app:tint="#888888"/>

        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@drawable/menu_vertical" app:tint="#888888"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/calendarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/CustomCalendar"
            android:firstDayOfWeek="2"
            android:layout_marginTop="-42dp" /> </FrameLayout>

    <LinearLayout
        android:id="@+id/weekViewLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <TextView android:id="@+id/tvSen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sen\n-" android:textAlignment="center" android:textColor="#333333" android:textStyle="bold"/>
        <TextView android:id="@+id/tvSel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sel\n-" android:textAlignment="center" android:textColor="#333333" android:textStyle="bold"/>
        <TextView android:id="@+id/tvRab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Rab\n-" android:textAlignment="center" android:textColor="#333333" android:textStyle="bold"/>
        <TextView android:id="@+id/tvKam" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Kam\n-" android:textAlignment="center" android:textColor="#333333" android:textStyle="bold"/>
        <TextView android:id="@+id/tvJum" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Jum\n-" android:textAlignment="center" android:textColor="#333333" android:textStyle="bold"/>
        <TextView android:id="@+id/tvSab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sab\n-" android:textAlignment="center" android:textColor="#333333" android:textStyle="bold"/>
        <TextView android:id="@+id/tvMin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Min\n-" android:textAlignment="center" android:textColor="#333333" android:textStyle="bold"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#33dbcc"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_input_add"
            app:tint="#FFFFFF"/>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>