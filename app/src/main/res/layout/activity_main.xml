<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F7">

    <!-- CATEGORY -->

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <!-- SEMUA -->

            <TextView
                android:layout_width="120dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="Semua"
                android:textColor="#666666"
                android:textSize="18sp"
                android:background="@drawable/category_unselected"/>

            <!-- KERJA -->

            <TextView
                android:layout_width="120dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="Kerja"
                android:textColor="#666666"
                android:textSize="18sp"
                android:layout_marginStart="16dp"
                android:background="@drawable/category_unselected"/>

            <!-- PRIBADI -->

            <TextView
                android:layout_width="120dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="Pribadi"
                android:textColor="#666666"
                android:textSize="18sp"
                android:layout_marginStart="16dp"
                android:background="@drawable/category_unselected"/>

            <!-- WISHLIST -->

            <TextView
                android:layout_width="120dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="Wishlist"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:background="@drawable/category_selected"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- MENU -->

    <ImageView
        android:id="@+id/btnMenu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="20dp"
        android:src="@android:drawable/ic_menu_more"
        app:tint="#999999"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- EMPTY IMAGE -->
    <ImageView
        android:id="@+id/imgEmpty"
        android:layout_width="330dp"
        android:layout_height="330dp"
        android:src="@drawable/empty_task"
        android:scaleType="fitCenter"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- EMPTY TEXT -->

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tidak ada tugas dalam kategori ini."
        android:textColor="#666666"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="500dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Klik + untuk membuat tugasmu"
        android:textColor="#888888"
        android:textSize="20sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvEmpty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- FAB -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="100dp"
        android:src="@android:drawable/ic_input_add"
        android:backgroundTint="#7FA7FF"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTTOM NAV -->

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- MENU -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#BDBDBD"/>

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_red"/>

        </LinearLayout>

        <!-- TUGAS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#5B8CFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tugas"
                android:textColor="#5B8CFF"
                android:textSize="16sp"/>

        </LinearLayout>

        <!-- KALENDER -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="#C4C4C4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kalender"
                android:textColor="#C4C4C4"
                android:textSize="16sp"/>

        </LinearLayout>

        <!-- PROFILE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#C4C4C4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Milikku"
                android:textColor="#C4C4C4"
                android:textSize="16sp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>