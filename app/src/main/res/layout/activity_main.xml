<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:contentDescription="Foto Profil User"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/robotosemibold"
        tools:text="Selamat Pagi👋"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toTopOf="@id/imgProfile"
        app:layout_constraintStart_toEndOf="@id/imgProfile"
        app:layout_constraintEnd_toStartOf="@id/Notification" />

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Nama User"
        android:textColor="#888"
        android:fontFamily="@font/robotosemibold"
        android:layout_marginEnd="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintEnd_toStartOf="@id/Notification" />

    <ImageView
        android:id="@+id/Notification"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="Ikon Notifikasi"
        android:src="@drawable/notification"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgProfile" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardChallenge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#13B5C7"
        app:layout_constraintTop_toBottomOf="@id/imgProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <ImageView
                android:id="@+id/icFolder"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#FFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review Client Proposal"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/icFolder"
                app:layout_constraintBottom_toBottomOf="@id/icFolder"
                app:layout_constraintStart_toEndOf="@id/icFolder" />

            <LinearLayout
                android:id="@+id/layoutTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvCardTitle"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Today"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"/>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 16"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"/>
                </com.google.android.material.card.MaterialCardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="High Priority"
                        android:textColor="#FF5C5C"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Check the client's proposal to make sure everything is correct and ready to send. Make edits if needed and prepare for approval."
                android:textColor="#E0FFFF"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/layoutTags"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/avatar1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/ic_launcher_background"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/avatar2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="-10dp"
                android:src="@drawable/ic_launcher_background"
                app:layout_constraintTop_toTopOf="@id/avatar1"
                app:layout_constraintStart_toEndOf="@id/avatar1" />

            <ImageView
                android:id="@+id/avatar3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="-10dp"
                android:src="@drawable/ic_launcher_background"
                app:layout_constraintTop_toTopOf="@id/avatar1"
                app:layout_constraintStart_toEndOf="@id/avatar2" />

            <ImageView
                android:id="@+id/avatar4"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="-10dp"
                android:src="@drawable/ic_launcher_background"
                app:layout_constraintTop_toTopOf="@id/avatar1"
                app:layout_constraintStart_toEndOf="@id/avatar3" />

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progres"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toTopOf="@id/avatar1"
                app:layout_constraintStart_toEndOf="@id/avatar4" />

            <TextView
                android:id="@+id/tvProgressValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:layout_constraintTop_toTopOf="@id/avatar1"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:progress="80"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#40FFFFFF"
                app:layout_constraintBottom_toBottomOf="@id/avatar1"
                app:layout_constraintStart_toStartOf="@id/tvProgressLabel"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvTaskLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Task for you"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardChallenge"
        app:layout_constraintStart_toStartOf="@id/cardChallenge" />

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvTaskLabel"
        app:layout_constraintStart_toStartOf="@id/cardChallenge"
        app:layout_constraintEnd_toEndOf="@id/cardChallenge">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
            <TextView
                android:id="@+id/taskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Design app to-do list"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@color/status_high_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="High"
                android:textColor="@color/status_high_text" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent">
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>