<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.StudyGo" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    </style>

    <style name="CalendarDateCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:fontFamily">@font/robotomedium</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CustomCalendar" parent="Theme.AppCompat.Light">
        <item name="android:dateTextAppearance">@style/CalendarDateTextAppearance</item>
        <item name="android:weekDayTextAppearance">@style/CalendarWeekTextAppearance</item>

        <item name="colorAccent">#33dbcc</item>
        <item name="android:colorAccent">#33dbcc</item>
    </style>

    <style name="CalendarDateTextAppearance" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#333333</item>

        <item name="android:fontFamily">@font/robotobold</item>
    </style>

    <style name="CalendarWeekTextAppearance" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#888888</item>
        <item name="android:fontFamily">@font/robotomedium</item>
    </style>

</resources>